# Los scripts que corren dentro de los contenedores Linux deben tener fin de
# línea LF. Sin esto, Git para Windows los convierte a CRLF y bash falla
# (por ejemplo, postgres-primario queda "unhealthy").
*.sh        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.pem       text eol=lf
